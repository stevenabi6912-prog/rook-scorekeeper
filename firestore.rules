rules_version = '2';

// Rook Scorekeeper rules.
//
// Everything lives under /families/{code}/... where {code} is the family
// passcode. Anyone who has signed in (anonymously) AND knows the passcode can
// read and write that family's data. Nothing outside /families is reachable.
//
// This is deliberately simple and is appropriate for a family scoreboard, not
// for sensitive data. See README.md ("Security model and its limits").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Passcodes are normalized client-side to 4-64 chars; reject anything else
    // so random probing of short codes is less attractive.
    function validCode(code) {
      return code.size() >= 4 && code.size() <= 64;
    }

    match /families/{code} {
      // The family document itself is never written; only its subcollections.
      allow read: if signedIn() && validCode(code);
      allow write: if false;

      match /players/{playerId} {
        allow read: if signedIn() && validCode(code);
        allow create: if signedIn() && validCode(code)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.archived is bool
          && request.resource.data.createdAt is number;
        allow update: if signedIn() && validCode(code)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
        allow delete: if false;
      }

      // ---------------------------------------------------------------
      // Online play (branch online-play). A match is a table; its public
      // document is readable by the family. Each seat's cards and the Kitty
      // are private sub-documents. Everything here is additive: the rules
      // for players, games and hands above are unchanged.
      // ---------------------------------------------------------------
      match /matches/{matchId} {
        function match() {
          return get(/databases/$(database)/documents/families/$(code)/matches/$(matchId)).data;
        }
        function isHost() {
          return signedIn() && match().hostUid == request.auth.uid;
        }
        function seatUid(seat) {
          return match().seats[seat].uid;
        }
        function isSeated() {
          // Any seat held by this phone. Seats 4 and 5 only exist at a 6-player table.
          return signedIn() && (
            seatUid(0) == request.auth.uid || seatUid(1) == request.auth.uid || seatUid(2) == request.auth.uid
            || seatUid(3) == request.auth.uid
            || (match().seats.size() > 4 && seatUid(4) == request.auth.uid)
            || (match().seats.size() > 5 && seatUid(5) == request.auth.uid));
        }
        function betweenHands() {
          return match().pub == null || match().pub.phase == 'over';
        }
        // The clock has run out on the seat whose move it is (one minute plus grace).
        function turnIsStale() {
          return match().pub != null && request.time.toMillis() > match().turnStartedAt + 64000;
        }
        function movingSeat() {
          return request.resource.data.lastMove.seat;
        }
        // Who may commit the move being written: the phone in that seat, the
        // host for a bot seat, or anyone seated once the clock has run out.
        function mayMoveFor(seat) {
          return seatUid(seat) == request.auth.uid
            || (isHost() && match().seats[seat].bot)
            || (isSeated() && turnIsStale());
        }

        allow read: if signedIn() && validCode(code);
        allow create: if signedIn() && validCode(code)
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.status == 'seating'
          && request.resource.data.handedness in [4, 6]
          && request.resource.data.seats.size() == request.resource.data.handedness
          && request.resource.data.gameId is string
          && request.resource.data.pub == null;
        // Seat claims and host housekeeping keep pub unchanged; a move changes pub
        // and names the seat it was made for.
        allow update: if signedIn() && validCode(code) && (
          (request.resource.data.pub == resource.data.pub && (isHost() || isSeated() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'updatedAt'])))
          || (isHost() && betweenHands())
          || (request.resource.data.lastMove != null && mayMoveFor(movingSeat())));
        allow delete: if isHost();

        match /seats/{seat} {
          // Your own cards; the host may see a bot's cards; anyone seated may
          // see a stalled seat's cards to move for it.
          allow read: if signedIn() && validCode(code) && (
            seatUid(int(seat)) == request.auth.uid
            || (isHost() && match().seats[int(seat)].bot)
            || (isSeated() && turnIsStale() && match().pub.turnSeat == int(seat)));
          allow write: if signedIn() && validCode(code) && (
            (isHost() && betweenHands())
            || seatUid(int(seat)) == request.auth.uid
            || (isHost() && match().seats[int(seat)].bot)
            || (isSeated() && turnIsStale() && match().pub.turnSeat == int(seat)));
        }

        match /nest/{nestId} {
          function bidderUid() {
            return match().seats[match().pub.bidderSeat].uid;
          }
          function bidderIsBot() {
            return match().seats[match().pub.bidderSeat].bot;
          }
          // The bidder reads the Kitty to pick it up; everyone may see it once the hand is over.
          allow read: if signedIn() && validCode(code) && match().pub != null && (
            match().pub.phase == 'over'
            || (match().pub.phase == 'nest' && match().pub.bidderSeat != null
                && (bidderUid() == request.auth.uid || (isHost() && bidderIsBot()) || (isSeated() && turnIsStale()))));
          allow write: if signedIn() && validCode(code) && (
            (isHost() && betweenHands())
            || (match().pub != null && match().pub.phase == 'nest' && match().pub.bidderSeat != null
                && (bidderUid() == request.auth.uid || (isHost() && bidderIsBot()) || (isSeated() && turnIsStale()))));
        }
      }

      match /games/{gameId} {
        allow read: if signedIn() && validCode(code);
        allow create: if signedIn() && validCode(code)
          && request.resource.data.handedness in [4, 6]
          && request.resource.data.status == 'active'
          && request.resource.data.seatOrder is list
          && request.resource.data.seatOrder.size() == request.resource.data.handedness
          && request.resource.data.teams.A.playerIds is list
          && request.resource.data.teams.B.playerIds is list
          && request.resource.data.createdAt is number;
        allow update: if signedIn() && validCode(code)
          && request.resource.data.status in ['active', 'finished']
          && request.resource.data.handedness == resource.data.handedness
          && (!('currentTrump' in request.resource.data)
              || request.resource.data.currentTrump == null
              || request.resource.data.currentTrump in ['red', 'yellow', 'green', 'black']);
        allow delete: if signedIn() && validCode(code);

        match /hands/{handId} {
          function validHand(h) {
            return h.handNumber is int && h.handNumber >= 1
              && h.dealerId is string
              && h.bidderId is string
              && h.bidTeam in ['A', 'B']
              && (h.bid == 'moon'
                  || (h.bid is int && h.bid >= 65 && h.bid <= 120 && h.bid % 5 == 0))
              && h.pointsTaken is int && h.pointsTaken >= 0 && h.pointsTaken <= 120 && h.pointsTaken % 5 == 0
              && (h.bid != 'moon' || h.moonMade is bool)
              && (!('rookHolderId' in h) || h.rookHolderId == null || h.rookHolderId is string)
              && (!('trump' in h) || h.trump == null || h.trump in ['red', 'yellow', 'green', 'black']);
          }
          allow read: if signedIn() && validCode(code);
          allow create, update: if signedIn() && validCode(code) && validHand(request.resource.data);
          allow delete: if signedIn() && validCode(code);
        }
      }
    }
  }
}
